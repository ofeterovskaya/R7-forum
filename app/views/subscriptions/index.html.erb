<p style="color: green"><%= notice %></p>

<h1>Subscriptions</h1>

<div id="subscriptions">
  <% @forums.each do |forum| %>
    <%= render partial: "forums/forum", locals: { forum: forum } %>
    <%= render forum.posts.order(updated_at: :desc) %>
    <%= link_to "Create a new post", new_forum_post_path(forum) %>
    
    <% subscription = Subscription.find_by(forum_id: forum.id, user_id: @current_user.id) %>
    <% if subscription %>
      <%= link_to "Show this subscription", subscription_path(subscription) %>
      <%= link_to "Edit this subscription", edit_subscription_path(subscription) %>
      <%= link_to "Delete this subscription", subscription_path(subscription), method: :delete, data: { confirm: "Are you sure?" } %>
    <% else %>
      <%= link_to "New subscription", new_forum_subscription_path(forum) %>
    <% end %>
  <% end %>
</div>

